# Cadena de conexion directa a la base de datos.
# Usala con tu Postgres local o con Supabase; no debe ir en el browser.
DATABASE_URL=

# Secreto aleatorio para firmar la sesion y otros datos sensibles de Better
# Auth.
#
# Genera un valor nuevo por entorno y nunca lo compartas.
#
# Un valor secreto utilizado para cifrado y hash. Debe tener al menos 32
# caracteres y generarse con alta entropía. Puedes usar `openssl rand -base64
# 32` para generarlo.
BETTER_AUTH_SECRET=

# URL base publica de la app.
# Debe coincidir con el origen desde donde corre Next.js en ese entorno.
BETTER_AUTH_URL=http://localhost:3000

# Credenciales OAuth de Google para el provider de login.
# Se configuran en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email de contacto que se muestra cuando la creacion de comunidad no esta permitida.
# Si lo dejas vacio, se ocultara el contacto en la UI.
CONTACT_EMAIL=
