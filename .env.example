# Cadena de conexion de runtime a la base de datos.
# Usala con Postgres local o Neon. En Neon se recomienda usar la URL pooled
# para runtime; no debe ir en el browser.
DATABASE_URL=

# Cadena de conexion directa para migraciones y tooling.
# En Neon se recomienda usar una URL sin pooler cuando la herramienta abre
# conexiones largas o necesita comportamiento directo de Postgres.
DATABASE_MIGRATION_URL=

# Secreto aleatorio para firmar la sesion y otros datos sensibles de Better
# Auth.
#
# Genera un valor nuevo por entorno y nunca lo compartas.
#
# Un valor secreto utilizado para cifrado y hash. Debe tener al menos 32
# caracteres y generarse con alta entropía. Puedes usar `openssl rand -base64
# 32` para generarlo.
BETTER_AUTH_SECRET=

# URL base publica de la app.
# Debe coincidir con el origen desde donde corre Next.js en ese entorno.
BETTER_AUTH_URL=http://localhost:3000

# Credenciales OAuth de Google para el provider de login.
# Se configuran en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL base opcional del backend separado de TuTribu.
# Dejala vacia cuando Next.js resuelve las rutas internamente.
# Si se configura, debe ser una URL absoluta con HTTPS, o HTTP solo para
# localhost/127.0.0.1 en desarrollo.
TUTRIBU_BACKEND_BASE_URL=

# Email de contacto que se muestra cuando la creacion de tribu no esta permitida.
# Si lo dejas vacio, se ocultara el contacto en la UI.
CONTACT_EMAIL=

# Clave simetrica para cifrar at-rest los tokens de invitacion a tribus.
# Debe codificar 32 bytes en base64 (AES-256-GCM).
# Genera un valor con `openssl rand -base64 32` y guardalo solo en el servidor.
TRIBE_INVITATION_TOKEN_ENCRYPTION_KEY=

# Credenciales server-side de Cloudflare Images para adjuntos del feed.
# El token debe permitir Direct Creator Uploads, consulta y borrado de imágenes.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_DELIVERY_VARIANT=public

# Credenciales de la aplicación OAuth de TuTribu en Mercado Pago.
# Estas NO son credenciales de cada líder: cada líder autoriza su cuenta
# desde la UI, y los tokens resultantes se guardan server-side por tribu.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=

# URL base pública usada como back_url en los planes y suscripciones de
# Mercado Pago. Mercado Pago requiere una URL HTTPS pública y no acepta
# localhost, por lo que en desarrollo local debes configurar un túnel
# (ej.: ngrok) y poner su URL aquí.
# En producción dejá esta variable vacía: se usa BETTER_AUTH_URL automáticamente.
MERCADO_PAGO_BACK_URL=
