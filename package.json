{
  "name": "tutribu",
  "version": "1.10.1",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "pnpm": ">=12 <13",
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev-portless.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "create-version": "golfo-rp create-version",
    "cv": "golfo-rp create-version",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:tests && pnpm run test && pnpm run build",
    "commitlint": "commitlint --from HEAD~30 --to HEAD --verbose",
    "prepare": "husky",
    "lint": "golfo-lint lint",
    "typecheck": "bun check -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/push-migrations.js",
    "db:migrate:force": "node scripts/push-migrations.js --force",
    "db:sandbox": "node scripts/dev-database-sandbox.mjs",
    "messaging:enroll-keys": "node scripts/enroll-messaging-key-materials.mjs",
    "test:e2e": "playwright test",
    "test:ui": "pnpm build && node scripts/e2e/run-ui-tests.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:beezping": "playwright test --config playwright.beezping.config.ts",
    "e2e:cleanup": "cleaner playwright",
    "typecheck:tests": "bun check -p tsconfig.test.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-presigned-post": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@beezping/widget": "0.12.0",
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@github/relative-time-element": "^5.0.0",
    "@golfo/ui": "^2.2.0",
    "@next/env": "^16.3.4",
    "@tanstack/redact": "^0.2.0",
    "@zavudev/sdk": "0.57.0",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "emoji-picker-react": "^4.19.1",
    "files-sdk": "^1.8.0",
    "libphonenumber-js": "^1.13.3",
    "lucide-react": "^1.16.0",
    "motion": "^12.43.0",
    "next": "^16.3.4",
    "pg": "^8.21.0",
    "pg-cloudflare": "1.4.0",
    "radix-ui": "1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@golfo/cleaner": "^1.0.0",
    "@golfo/lint": "0.3.0",
    "@golfo/rp": "^2.0.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.13.0",
    "husky": "^9.1.7",
    "ical.js": "^2.2.1",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "oxc-transform-react": "^0.145.0",
    "react-doctor": "0.9.18",
    "sass": "^1.100.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.128.0"
  }
}
