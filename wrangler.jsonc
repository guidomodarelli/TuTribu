{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutribu",
  // Custom entrypoint that re-uses the generated OpenNext `fetch` handler and
  // adds the `scheduled` handler for the maintenance cron below. It imports
  // `.open-next/worker.js`, produced by `opennextjs-cloudflare build`.
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-05-31",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tutribu"
    }
  ],
  // Parity with the Vercel crons in `vercel.json`: sweep orphaned Cloudflare
  // image assets daily at 04:00 UTC through `/api/maintenance/image-cleanup`,
  // and orphaned R2 attachment files at 04:30 UTC through
  // `/api/maintenance/file-cleanup`, and enqueue due event reminders (plus the
  // read-notification purge) every 5 minutes through
  // `/api/maintenance/event-reminders`. Keep these schedules in sync with
  // `vercel.json` and with `MAINTENANCE_CRON_SCHEDULE` in
  // `config/cloudflare-scheduled-maintenance.ts`, which maps each firing
  // expression to its route.
  "triggers": {
    "crons": ["0 4 * * *", "30 4 * * *", "*/5 * * * *"]
  }
}
